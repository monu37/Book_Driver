@model List<BookDriver.ViewModels.BookingListItemViewModel>
@{
    ViewData["Title"] = "Ride requests";
}

<h1 class="mb-3">@ViewData["Title"]</h1>
<p><a asp-action="DriverHistory">View past rides &rarr;</a></p>

@if (!Model.Any())
{
    <div class="alert alert-info">No ride requests yet.</div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Customer</th>
                <th>Car</th>
                <th>Pickup</th>
                <th>Drop-off</th>
                <th>Trip starts</th>
                <th>Hours</th>
                <th>Distance to pickup</th>
                <th>Est. fare</th>
                <th>Status</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.OtherPartyName</td>
                    <td>@b.CarModel <div class="text-muted small">@b.CarNumber</div></td>
                    <td>@b.PickupAddress</td>
                    <td>@b.DropoffAddress</td>
                    <td>@b.TripStartAt.ToString("g")</td>
                    <td>@b.EstimatedHours.ToString("0.#")</td>
                    <td>@b.DistanceKm.ToString("0.0") km</td>
                    <td>₹@b.EstimatedFare.ToString("0.##")</td>
                    <td><span class="badge bg-@StatusBadge(b.Status)">@b.Status</span></td>
                    <td class="text-nowrap">
                        @if (b.Status == BookDriver.Models.BookingStatus.Pending)
                        {
                            <form method="post" asp-action="Accept" asp-route-id="@b.Id" class="d-inline">
                                <button class="btn btn-sm btn-success">Accept</button>
                            </form>
                            <form method="post" asp-action="Reject" asp-route-id="@b.Id" class="d-inline">
                                <button class="btn btn-sm btn-outline-danger">Reject</button>
                            </form>
                        }
                        else if (b.Status == BookDriver.Models.BookingStatus.Accepted)
                        {
                            <form method="post" asp-action="Complete" asp-route-id="@b.Id" class="d-inline">
                                <button class="btn btn-sm btn-primary">Mark completed</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@functions {
    string StatusBadge(BookDriver.Models.BookingStatus status) => status switch
    {
        BookDriver.Models.BookingStatus.Pending => "warning",
        BookDriver.Models.BookingStatus.Accepted => "primary",
        BookDriver.Models.BookingStatus.Completed => "success",
        BookDriver.Models.BookingStatus.Rejected => "danger",
        BookDriver.Models.BookingStatus.Cancelled => "secondary",
        _ => "secondary",
    };
}
