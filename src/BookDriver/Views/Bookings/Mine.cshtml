@model List<BookDriver.ViewModels.BookingListItemViewModel>
@{
    ViewData["Title"] = "My bookings";
}

<h1 class="mb-3">@ViewData["Title"]</h1>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

@if (!Model.Any())
{
    <div class="alert alert-info">
        You have no bookings yet. <a asp-controller="Drivers" asp-action="Nearby">Find a driver near you</a>.
    </div>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th>Driver</th>
                <th>Pickup</th>
                <th>Drop-off</th>
                <th>Est. fare</th>
                <th>Status</th>
                <th>Requested</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var b in Model)
            {
                <tr>
                    <td>@b.OtherPartyName <div class="text-muted small">@b.VehicleModel</div></td>
                    <td>@b.PickupAddress</td>
                    <td>@b.DropoffAddress</td>
                    <td>₹@b.EstimatedFare.ToString("0.##")</td>
                    <td><span class="badge bg-@StatusBadge(b.Status)">@b.Status</span></td>
                    <td>@b.RequestedAt.ToLocalTime().ToString("g")</td>
                    <td>
                        @if (b.Status == BookDriver.Models.BookingStatus.Pending)
                        {
                            <form method="post" asp-action="Cancel" asp-route-id="@b.Id" onsubmit="return confirm('Cancel this booking?');">
                                <button class="btn btn-sm btn-outline-danger">Cancel</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@functions {
    string StatusBadge(BookDriver.Models.BookingStatus status) => status switch
    {
        BookDriver.Models.BookingStatus.Pending => "warning",
        BookDriver.Models.BookingStatus.Accepted => "primary",
        BookDriver.Models.BookingStatus.Completed => "success",
        BookDriver.Models.BookingStatus.Rejected => "danger",
        BookDriver.Models.BookingStatus.Cancelled => "secondary",
        _ => "secondary",
    };
}
