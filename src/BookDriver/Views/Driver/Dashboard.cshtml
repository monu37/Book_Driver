@model BookDriver.ViewModels.DriverDashboardViewModel
@{
    ViewData["Title"] = "Driver dashboard";
}

<h1 class="mb-1">Welcome, @Model.FullName</h1>
<p class="text-warning mb-3" title="@BookDriver.Services.RatingDisplay.Label(Model.AverageRating, Model.RatingCount)">
    @BookDriver.Services.RatingDisplay.Stars(Model.AverageRating)
    <span class="text-muted small">@BookDriver.Services.RatingDisplay.Label(Model.AverageRating, Model.RatingCount)</span>
</p>

<form id="antiForgeryForm">@Html.AntiForgeryToken()</form>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success">@success</div>
}

<div class="row g-4">
    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Availability &amp; location</h5>

                <p>
                    Status:
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success">Available for rides</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Offline</span>
                    }
                </p>

                <form method="post" asp-action="ToggleAvailability" class="mb-3">
                    <button class="btn @(Model.IsAvailable ? "btn-outline-secondary" : "btn-success")">
                        @(Model.IsAvailable ? "Go offline" : "Go online")
                    </button>
                </form>

                <p class="text-muted mb-1">Current location:</p>
                <p id="currentLocation">@Model.Latitude.ToString("F6"), @Model.Longitude.ToString("F6")</p>
                <p class="text-muted small">Last updated: @Model.LocationUpdatedAt.ToLocalTime().ToString("g")</p>

                <button type="button" id="shareLocation" class="btn btn-primary">Share my current location</button>
                <p id="locationStatus" class="text-muted mt-2"></p>

                @if (Model.HasActiveRide)
                {
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="autoTrack">
                        <label class="form-check-label" for="autoTrack">
                            Auto-update my location every 15s (you have a ride in progress — the customer can track you live)
                        </label>
                    </div>
                }

                @if (Model.PendingRequestCount > 0)
                {
                    <div class="alert alert-warning mt-3 mb-0">
                        You have @Model.PendingRequestCount pending ride request(s).
                        <a asp-controller="Bookings" asp-action="Requests">View requests</a>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">License &amp; rate</h5>
                <form method="post" asp-action="UpdateProfile">
                    <div asp-validation-summary="All" class="text-danger" role="alert"></div>
                    <div class="mb-3">
                        <label asp-for="LicenseNumber" class="form-label"></label>
                        <input asp-for="LicenseNumber" class="form-control" />
                        <span asp-validation-for="LicenseNumber" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="YearsOfExperience" class="form-label"></label>
                        <input asp-for="YearsOfExperience" class="form-control" type="number" />
                        <span asp-validation-for="YearsOfExperience" class="text-danger"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="RatePerHour" class="form-label"></label>
                        <input asp-for="RatePerHour" class="form-control" type="number" step="10" />
                        <span asp-validation-for="RatePerHour" class="text-danger"></span>
                    </div>
                    <button type="submit" class="btn btn-primary">Save</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const status = document.getElementById('locationStatus');

        function pushLocation(silent) {
            if (!navigator.geolocation) {
                status.textContent = 'Geolocation is not supported by your browser.';
                return;
            }
            if (!silent) { status.textContent = 'Locating you…'; }
            navigator.geolocation.getCurrentPosition(function (pos) {
                const lat = pos.coords.latitude;
                const lng = pos.coords.longitude;

                fetch('@Url.Action("UpdateLocation", "Driver")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: `lat=${lat}&lng=${lng}`
                }).then(function (res) {
                    if (res.ok) {
                        document.getElementById('currentLocation').textContent = lat.toFixed(6) + ', ' + lng.toFixed(6);
                        status.textContent = 'Location updated ' + new Date().toLocaleTimeString() + '.';
                    } else {
                        status.textContent = 'Could not update location.';
                    }
                });
            }, function () {
                status.textContent = 'Could not get your location. Please allow location access.';
            });
        }

        document.getElementById('shareLocation').addEventListener('click', function () { pushLocation(false); });

        const autoTrack = document.getElementById('autoTrack');
        let autoTrackTimer = null;
        if (autoTrack) {
            autoTrack.addEventListener('change', function () {
                if (autoTrack.checked) {
                    pushLocation(true);
                    autoTrackTimer = setInterval(function () { pushLocation(true); }, 15000);
                } else if (autoTrackTimer) {
                    clearInterval(autoTrackTimer);
                    autoTrackTimer = null;
                }
            });
        }
    </script>
}
