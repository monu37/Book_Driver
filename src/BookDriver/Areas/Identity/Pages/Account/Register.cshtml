@page
@model BookDriver.Areas.Identity.Pages.Account.RegisterModel
@{
    ViewData["Title"] = "Create account";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <h1 class="mb-3">@ViewData["Title"]</h1>
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="All" class="text-danger" role="alert"></div>

            <div class="mb-3">
                <label class="form-label">I want to</label>
                <div class="btn-group w-100" role="group">
                    <input type="radio" class="btn-check" name="Input.AccountType" id="typeCustomer" value="Customer" checked>
                    <label class="btn btn-outline-primary" for="typeCustomer">Book a driver</label>

                    <input type="radio" class="btn-check" name="Input.AccountType" id="typeDriver" value="Driver">
                    <label class="btn btn-outline-primary" for="typeDriver">Drive &amp; earn</label>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.FullName" class="form-label"></label>
                <input asp-for="Input.FullName" class="form-control" autocomplete="name" />
                <span asp-validation-for="Input.FullName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Email" class="form-label"></label>
                <input asp-for="Input.Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.PhoneNumber" class="form-label"></label>
                <input asp-for="Input.PhoneNumber" class="form-control" autocomplete="tel" />
                <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
            </div>

            <div id="driverFields" class="border rounded p-3 mb-3 bg-light" style="display:none;">
                <h6>Driver &amp; vehicle details</h6>
                <div class="mb-3">
                    <label asp-for="Input.VehicleModel" class="form-label"></label>
                    <input asp-for="Input.VehicleModel" class="form-control" />
                    <span asp-validation-for="Input.VehicleModel" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.VehiclePlateNumber" class="form-label"></label>
                    <input asp-for="Input.VehiclePlateNumber" class="form-control" />
                    <span asp-validation-for="Input.VehiclePlateNumber" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Input.RatePerKm" class="form-label"></label>
                    <input asp-for="Input.RatePerKm" class="form-control" type="number" step="0.5" />
                    <span asp-validation-for="Input.RatePerKm" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Input.Password" class="form-label"></label>
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label"></label>
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="w-100 btn btn-lg btn-primary">Create account</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const driverFields = document.getElementById('driverFields');
        function toggleDriverFields() {
            const isDriver = document.getElementById('typeDriver').checked;
            driverFields.style.display = isDriver ? 'block' : 'none';
        }
        document.getElementById('typeCustomer').addEventListener('change', toggleDriverFields);
        document.getElementById('typeDriver').addEventListener('change', toggleDriverFields);
        toggleDriverFields();
    </script>
}
